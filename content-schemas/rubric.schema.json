{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgres-foundations/schema/rubric.schema.json",
  "title": "PostgreSQL Foundations rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "applies_to", "dimensions", "pass_threshold"],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/id_slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "string",
      "enum": ["exercise", "capstone", "scenario", "interview"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight", "levels"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "levels": {
            "type": "object",
            "additionalProperties": false,
            "required": ["0", "1", "2", "3", "4"],
            "properties": {
              "0": {
                "type": "string",
                "minLength": 1
              },
              "1": {
                "type": "string",
                "minLength": 1
              },
              "2": {
                "type": "string",
                "minLength": 1
              },
              "3": {
                "type": "string",
                "minLength": 1
              },
              "4": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "pass_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
