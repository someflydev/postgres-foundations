{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgres-foundations/schema/rubric.schema.json",
  "title": "PostgreSQL Foundations rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "applies_to", "pass_threshold"],
  "anyOf": [
    { "required": ["dimensions"] },
    { "required": ["extends"] },
    { "required": ["own_dimensions"] }
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/id_slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "string",
      "enum": ["exercise", "capstone", "scenario", "interview"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "extends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rubric_id", "weight"],
        "properties": {
          "rubric_id": {
            "$ref": "common.json#/$defs/id_slug"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "own_dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "pass_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "weight", "levels"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3", "4"],
          "properties": {
            "0": {
              "type": "string",
              "minLength": 1
            },
            "1": {
              "type": "string",
              "minLength": 1
            },
            "2": {
              "type": "string",
              "minLength": 1
            },
            "3": {
              "type": "string",
              "minLength": 1
            },
            "4": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "levels"],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "levels": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              }
            }
          }
        }
      }
    }
  }
}
