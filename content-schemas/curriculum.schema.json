{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgres-foundations/schema/curriculum.schema.json",
  "title": "PostgreSQL Foundations curriculum map",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "phases", "domains", "loops", "capstones"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "slug",
          "title",
          "capability_layer",
          "summary",
          "goals",
          "concepts_introduced",
          "prerequisites",
          "exit_competencies",
          "clusters"
        ],
        "properties": {
          "number": {
            "$ref": "common.json#/$defs/phase"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "capability_layer": {
            "$ref": "common.json#/$defs/capability_layer"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "goals": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "concepts_introduced": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "common.json#/$defs/id_slug"
            },
            "uniqueItems": true
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "uniqueItems": true
          },
          "exit_competencies": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "clusters": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "title", "planned_lessons"],
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "planned_lessons": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "first_used_in_phase", "summary"],
        "properties": {
          "slug": {
            "$ref": "common.json#/$defs/id_slug"
          },
          "first_used_in_phase": {
            "$ref": "common.json#/$defs/phase"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "loops": {
      "type": "array",
      "prefixItems": [
        { "const": "lesson" },
        { "const": "lab" },
        { "const": "debug" },
        { "const": "design" },
        { "const": "review" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "capstones": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "primary_domains", "planned_prompt", "summary"],
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/id_slug"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "primary_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.json#/$defs/id_slug"
            },
            "uniqueItems": true
          },
          "planned_prompt": {
            "type": "integer",
            "enum": [25, 26]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
