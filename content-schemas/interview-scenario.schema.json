{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgres-foundations/schema/interview-scenario.schema.json",
  "title": "PostgreSQL Foundations interview scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "duration_minutes",
    "capability_layers_required",
    "stages",
    "rubric_id"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/id_slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "capability_layers_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.json#/$defs/capability_layer"
      },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "rubric_id": {
      "$ref": "common.json#/$defs/id_slug"
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "budget_minutes"],
      "oneOf": [
        { "required": ["prompt_template"] },
        { "required": ["exercise_id"] }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["warmup", "design_probe", "debugging_drill", "explainability"]
        },
        "topic": {
          "$ref": "common.json#/$defs/id_slug"
        },
        "prompt_template": {
          "type": "string",
          "pattern": "^interview/[a-z0-9_/-]+$"
        },
        "exercise_id": {
          "$ref": "common.json#/$defs/id_slug"
        },
        "budget_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    }
  }
}
