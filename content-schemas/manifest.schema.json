{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgres-foundations.local/schemas/manifest.schema.json",
  "title": "Seed domain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "phases_covered",
    "planned_phases",
    "depends_on_extensions",
    "notes"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "phases_covered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase_id"
      },
      "uniqueItems": true
    },
    "planned_phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase_id"
      },
      "uniqueItems": true
    },
    "depends_on_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "phase_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+[a-z]$"
        }
      ]
    }
  }
}
