{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgres-foundations/schema/recommendation.schema.json",
  "title": "Decision recommendation",
  "type": "object",
  "required": [
    "kind",
    "target_slug",
    "verdict",
    "original_verdict",
    "recommendation_class",
    "confidence",
    "recommendation_score",
    "score_breakdown",
    "why_now",
    "why_not_yet",
    "triggers_for_next_stage",
    "followup_questions",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": ["core_feature", "extension", "index_pattern", "topology_pattern", "anti_pattern_warning"]
    },
    "target_slug": { "$ref": "#/$defs/slug" },
    "verdict": {
      "enum": ["recommend_now", "candidate_later", "not_enough_evidence", "avoid_for_now"]
    },
    "original_verdict": {
      "enum": ["recommend_now", "candidate_later", "not_enough_evidence", "avoid_for_now"]
    },
    "recommendation_class": {
      "enum": ["recommend_now", "candidate_later", "not_enough_evidence", "avoid_for_now"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "recommendation_score": { "$ref": "#/$defs/score" },
    "score_breakdown": { "$ref": "#/$defs/score_breakdown" },
    "why_now": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "why_not_yet": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "triggers_for_next_stage": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "followup_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "title": { "type": "string", "minLength": 1 },
    "module_slug": { "type": ["string", "null"], "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "contribution"],
        "additionalProperties": false,
        "properties": {
          "rule_id": { "$ref": "#/$defs/slug" },
          "contribution": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "score_breakdown": {
      "type": "object",
      "required": [
        "domain_fit",
        "data_shape_fit",
        "workload_fit",
        "operational_feasibility",
        "growth_urgency",
        "portability_penalty",
        "complexity_penalty"
      ],
      "additionalProperties": false,
      "properties": {
        "domain_fit": { "$ref": "#/$defs/score" },
        "data_shape_fit": { "$ref": "#/$defs/score" },
        "workload_fit": { "$ref": "#/$defs/score" },
        "operational_feasibility": { "$ref": "#/$defs/score" },
        "growth_urgency": { "$ref": "#/$defs/score" },
        "portability_penalty": { "$ref": "#/$defs/score" },
        "complexity_penalty": { "$ref": "#/$defs/score" }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:-[a-z0-9_]+)*$"
    }
  }
}
