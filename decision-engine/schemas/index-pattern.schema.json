{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgres-foundations/schema/index-pattern.schema.json",
  "title": "Index pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "underlying_index_type",
    "applies_to_data_shapes",
    "applies_to_workload_patterns",
    "tradeoffs",
    "references"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "underlying_index_type": { "enum": ["btree", "gin", "gist", "brin", "hnsw", "ivfflat"] },
    "applies_to_data_shapes": { "$ref": "#/$defs/slug_array" },
    "applies_to_workload_patterns": { "$ref": "#/$defs/slug_array" },
    "tradeoffs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "references": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:-[a-z0-9_]+)*$"
    },
    "slug_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/slug" },
      "uniqueItems": true
    }
  }
}
